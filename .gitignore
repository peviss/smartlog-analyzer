# Secrets: local environment and keys (keep .env.example tracked)
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/

# Python tooling caches and test output
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Web UI (src/frontend): dependencies, build, test coverage, caches
node_modules/
src/frontend/dist/
src/frontend/coverage/
*.tsbuildinfo
.vite/
.eslintcache

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Claude Code: personal settings stay local (shared .claude/settings.json is tracked)
.claude/settings.local.json

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store
._*
Thumbs.db
