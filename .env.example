# SmartLog Analyzer: variables de entorno.
# Copiá este archivo a .env y ajustá los valores:  cp .env.example .env
# Las variables comentadas usan el valor por defecto de src/api/core/config.py.

# --- Docker Compose: PostgreSQL ------------------------------------------------
POSTGRES_USER=smartlog
# Obligatoria para docker compose.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=smartlog

# Puerto del host donde nginx publica la API.
HTTP_PORT=8080

# --- Base de datos -------------------------------------------------------------
# Solo se usa si corrés la app fuera de Docker: docker-compose la arma con las
# variables POSTGRES_* y la sobrescribe.
DATABASE_URL=postgresql+psycopg://smartlog:change-me@localhost:5432/smartlog
# DB_POOL_SIZE=5

# --- Aplicación ----------------------------------------------------------------
# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO
# APP_NAME="SmartLog Analyzer"
# APP_VERSION=0.1.0
# Puerto de uvicorn dentro del contenedor.
# PORT=8000

# Guarda en event.original el documento tal como llegó, si el emisor no lo manda.
# Sirve para reprocesar o para auditoría; duplica el espacio de cada log.
# INGEST_KEEP_ORIGINAL=false

# Arranque del contenedor (docker/entrypoint.sh).
# Aplica las migraciones (alembic upgrade head) antes de levantar la API.
RUN_MIGRATIONS=true
# Carga datos de ejemplo si la tabla de logs está vacía.
SEED_ON_START=false

# --- LLM -----------------------------------------------------------------------
# mock | anthropic | openai | google | ollama. "mock" funciona sin API key y sin costo.
LLM_PROVIDER=mock
LLM_MODEL=claude-haiku-5-5
# Obligatoria con anthropic, openai y google (no con ollama).
# LLM_API_KEY=sk-ant-...
# Endpoint opcional: una API compatible con OpenAI, un proxy o un Ollama remoto.
# Con ollama, el default es http://localhost:11434/v1 (desde Docker: http://host.docker.internal:11434/v1).
# LLM_BASE_URL=
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_TOKENS=2000
# Veces que se le devuelven al modelo los errores de validación antes de fallar.
# LLM_OUTPUT_RETRIES=1
# Latencia simulada del modelo mock.
# MOCK_LLM_LATENCY_MS=300

# --- Límites -------------------------------------------------------------------
# ANALYSIS_MAX_LOGS=500
# ANALYSIS_MAX_PATTERNS=50
# DEFAULT_PAGE_SIZE=50
# MAX_PAGE_SIZE=500
